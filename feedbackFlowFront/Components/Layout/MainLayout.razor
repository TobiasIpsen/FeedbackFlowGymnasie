@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-panel">
        <header class="top-row">
            <div class="top-row-meta">
                <span class="eyebrow">FeedbackFlow Gymnasie</span>
                <p class="top-row-title">Oversigt over opgaver, teams og feedback</p>
            </div>
            <a class="top-link" href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener noreferrer">Blazor Docs</a>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
