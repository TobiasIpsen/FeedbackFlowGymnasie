@page "/teacher/sets/new"
@inject QuestionService QuestionService
@inject QuestionSetService QuestionSetService
@inject NavigationManager NavigationManager

<PageTitle>Opret Opgavesaet</PageTitle>

<section class="glass-card reveal-up teacher-create-wrap">
	<h1>Opret opgavesaet</h1>
	<p class="lead-text">Vaelg hvilke spoergsmaal der skal indgaa i saettet, og afslut med Annuller eller Opret.</p>

	@if (!string.IsNullOrWhiteSpace(successMessage))
	{
		<p class="form-success">@successMessage</p>
	}

	@if (!string.IsNullOrWhiteSpace(errorMessage))
	{
		<p class="form-error">@errorMessage</p>
	}

	<div class="form-grid">
		<div class="field-block">
			<label for="setName">Navn paa opgavesaet</label>
			<InputText id="setName" class="form-control" @bind-Value="setName" />
		</div>

		<fieldset class="toggle-card">
			<legend>Eksamenssaet?</legend>
			<label class="choice-row">
				<InputRadioGroup @bind-Value="isExam">
					<InputRadio Value="true" /> Ja
					<InputRadio Value="false" /> Nej
				</InputRadioGroup>
			</label>
		</fieldset>

		<label class="check-row in-grid-check">
			<InputCheckbox @bind-Value="isDraft" />
			<span>Gem som kladde</span>
		</label>
	</div>

	<fieldset class="toggle-card checkbox-wrap">
		<legend>Vaelg spoergsmaal til saettet</legend>

		@if (isLoading)
		{
			<p>Henter spoergsmaal...</p>
		}
		else if (questions.Count == 0)
		{
			<p>Der er ingen gemte spoergsmaal endnu. Opret et spoergsmaal foerst.</p>
		}
		else
		{
			<div class="question-list">
				@foreach (var question in questions)
				{
					<label class="check-row question-item">
						<input type="checkbox"
							   checked="@selectedQuestionIds.Contains(question.Id)"
							   @onchange="(e) => ToggleQuestion(question.Id, e)" />
						<span>#@question.Id - @question.Points</span>
					</label>
				}
			</div>

			<p class="selection-count">Valgt: @selectedQuestionIds.Count spoergsmaal</p>
		}
	</fieldset>

	<div class="action-row">
		<button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Annuller</button>
		<button type="button" class="btn btn-brand" @onclick="CreateQuestionSetAsync" disabled="@(questions.Count == 0)">Opret</button>
	</div>
</section>

@code {
	private readonly List<QuestionListItem> questions = new();
	private readonly HashSet<int> selectedQuestionIds = new();

	private bool isLoading = true;
	private bool isExam;
	private bool isDraft = true;
	private string setName = string.Empty;
	private string? successMessage;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		var loadedQuestions = await QuestionService.GetQuestionsAsync();
		questions.Clear();
		questions.AddRange(loadedQuestions.OrderBy(q => q.Id));
		isLoading = false;
	}

	private void ToggleQuestion(int questionId, ChangeEventArgs eventArgs)
	{
		if (eventArgs.Value is bool isChecked && isChecked)
		{
			selectedQuestionIds.Add(questionId);
			return;
		}

		selectedQuestionIds.Remove(questionId);
	}

	private async Task CreateQuestionSetAsync()
	{
		successMessage = null;
		errorMessage = null;

		if (selectedQuestionIds.Count == 0)
		{
			errorMessage = "Vaelg mindst et spoergsmaal til opgavesaettet.";
			return;
		}

		var createdSet = await QuestionSetService.CreateQuestionSetAsync(
			setName,
			isExam,
			isDraft,
			selectedQuestionIds.ToList());

		successMessage = $"Opgavesaet oprettet (ID: {createdSet.Id}) med {createdSet.QuestionIds.Count} spoergsmaal.";
		ResetForm();
	}

	private void Cancel()
	{
		ResetForm();
		successMessage = null;
		errorMessage = null;
		NavigationManager.NavigateTo("/teacher");
	}

	private void ResetForm()
	{
		setName = string.Empty;
		isExam = false;
		isDraft = true;
		selectedQuestionIds.Clear();
	}
}
