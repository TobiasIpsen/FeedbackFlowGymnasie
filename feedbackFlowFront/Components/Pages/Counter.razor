@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<section class="glass-card reveal-up">
    <h1>Counter</h1>
    <p class="lead-text">Lille testmodul til at validere interaktiv server-rendering.</p>

    <div class="metric-tile">
        <p class="metric-label">Current count</p>
        <p class="metric-value" role="status">@currentCount</p>
    </div>

    <button class="btn-brand" @onclick="IncrementCount">Increment</button>
</section>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
