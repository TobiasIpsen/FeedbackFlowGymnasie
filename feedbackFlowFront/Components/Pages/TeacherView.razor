@page "/teacher"
@inject AssignmentService AssignmentService
@inject GradingService GradingService
@inject UserService UserService

<PageTitle>Teacher</PageTitle>

<section class="glass-card reveal-up">
	<h1>Laereroversigt</h1>
	<p class="lead-text">Hurtigt overblik over hold, vurderingskoe og opgaveflow for @teacherName.</p>
	<a class="cta-link" href="teacher/questions/new">Opret nyt spoergsmaal</a>
	<a class="cta-link" href="teacher/sets/new">Opret opgavesaet</a>

	<div class="page-grid">
		<article class="info-card">
			<h2>Aktive hold</h2>
			<p>@activeClasses hold med afleveringer i denne uge.</p>
		</article>

		<article class="info-card">
			<h2>Afventer feedback</h2>
			<p>@totalPending besvarelser staar klar til gennemgang.</p>
		</article>

		<article class="info-card">
			<h2>Koeliste</h2>
			@if (pendingReviews.Count == 0)
			{
				<p>Ingen afleveringer i koe lige nu.</p>
			}
			else
			{
				<ul class="compact-list">
					@foreach (var review in pendingReviews)
					{
						<li>@review.ClassName: @review.AssignmentTitle (@review.PendingCount)</li>
					}
				</ul>
			}
		</article>
	</div>
</section>

@code {
    private string teacherName = "laerer";
    private int activeClasses;
    private int totalPending;
    private List<GradingService.TeacherQueueItem> pendingReviews = new();

    protected override async Task OnInitializedAsync()
    {
        const int teacherId = 1;
        teacherName = await UserService.GetTeacherNameAsync(teacherId);
        activeClasses = await AssignmentService.GetActiveClassesForTeacherAsync(teacherId);
        pendingReviews = await GradingService.GetPendingReviewsAsync(teacherId);
        totalPending = pendingReviews.Sum(x => x.PendingCount);
    }

}
