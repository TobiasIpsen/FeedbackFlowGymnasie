@page "/teacher/questions/new"
@using feedbackFlowAPI.DTOs
@using feedbackFlowAPI.Helpers
@inject NavigationManager NavigationManager
@inject QuestionService QuestionService

<PageTitle>Opret Spørgsmål</PageTitle>

<section class="glass-card reveal-up teacher-create-wrap">
	<h1>Opret spørgsmål</h1>
	<p class="lead-text">Udgangspunktet er QuestionDTO med ekstra ja/nej-valg og afkrydsninger til laererens oprettelse.</p>

	@if (!string.IsNullOrWhiteSpace(successMessage))
	{
		<p class="form-success">@successMessage</p>
		<a class="cta-link" href="/teacher/sets/new">Ga til opgavesaet</a>
	}

	@if (!string.IsNullOrWhiteSpace(errorMessage))
	{
		<p class="form-error">@errorMessage</p>
	}

	<EditForm Model="form" OnValidSubmit="CreateQuestionAsync" FormName="createQuestionForm">
		<div class="form-grid">
			<div class="field-block">
				<label for="points">Point / opgaveindhold</label>
				<InputText id="points" class="form-control" @bind-Value="form.Points" />
			</div>

			<div class="field-block">
				<label for="imgSrc">Billede-URL (valgfri)</label>
				<InputText id="imgSrc" class="form-control" @bind-Value="form.ImgSrc" />
			</div>

			<div class="field-block">
				<label for="education">Uddannelse</label>
				<InputSelect id="education" class="form-control" @bind-Value="form.Education">
					@foreach (var education in Enum.GetValues<Education>())
					{
						<option value="@education">@education</option>
					}
				</InputSelect>
			</div>

			<div class="field-block">
				<label for="classLevel">Niveau</label>
				<InputSelect id="classLevel" class="form-control" @bind-Value="form.ClassLevel">
					@foreach (var classLevel in Enum.GetValues<ClassLevel>())
					{
						<option value="@classLevel">@classLevel</option>
					}
				</InputSelect>
			</div>

			<div class="field-block">
				<label for="difficulty">Sværhedsgrad</label>
				<InputSelect id="difficulty" class="form-control" @bind-Value="form.QuestionDifficulty">
					@foreach (var difficulty in Enum.GetValues<QuestionDifficulty>())
					{
						<option value="@difficulty">@difficulty</option>
					}
				</InputSelect>
			</div>
		</div>

		<div class="toggle-sections">
			<fieldset class="toggle-card">
				<legend>Digital eksamen?</legend>
				<label class="choice-row">
					<InputRadioGroup @bind-Value="isDigitalExam">
						<InputRadio Value="true" /> Ja
						<InputRadio Value="false" /> Nej
					</InputRadioGroup>
				</label>
			</fieldset>

			<fieldset class="toggle-card">
				<legend>Standardspørgsmål?</legend>
				<label class="choice-row">
					<InputRadioGroup @bind-Value="isStandardQuestion">
						<InputRadio Value="true" /> Ja
						<InputRadio Value="false" /> Nej
					</InputRadioGroup>
				</label>
			</fieldset>
		</div>

		<fieldset class="toggle-card checkbox-wrap">
			<legend>Kryds af for krav</legend>

			<label class="check-row">
				<InputCheckbox @bind-Value="requiresFormula" />
				<span>Kræver anvendelse af formel</span>
			</label>

			<label class="check-row">
				<InputCheckbox @bind-Value="requiresSpecificMethod" />
				<span>Kræver specifik metode</span>
			</label>

			<label class="check-row">
				<InputCheckbox @bind-Value="markAsPartiallyStandard" />
				<span>Delvist standardopgave</span>
			</label>

			<label class="check-row">
				<InputCheckbox @bind-Value="markWithTwist" />
				<span>Med et twist</span>
			</label>

			<label class="check-row">
				<InputCheckbox @bind-Value="markAsDeleted" />
				<span>Markeres som slettet ved oprettelse</span>
			</label>
		</fieldset>

		<div class="action-row">
			<button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Annuller</button>
			<button type="submit" class="btn btn-brand">Opret</button>
		</div>
	</EditForm>
</section>

@code {
	private QuestionDTO form = new()
	{
		Education = Education.STX,
		ClassLevel = ClassLevel.B,
		QuestionDifficulty = QuestionDifficulty.Medium,
		ExamType = ExamType.Digital,
		QuestionMethodRequirement = QuestionMethodRequirement.NoRequirement,
		StandardQuestion = StandardQuestion.No
	};

	private bool isDigitalExam = true;
	private bool isStandardQuestion;
	private bool requiresFormula;
	private bool requiresSpecificMethod;
	private bool markAsPartiallyStandard;
	private bool markWithTwist;
	private bool markAsDeleted;
	private string? successMessage;
	private string? errorMessage;

	private async Task CreateQuestionAsync()
	{
		successMessage = null;
		errorMessage = null;

		if (string.IsNullOrWhiteSpace(form.Points))
		{
			errorMessage = "Point/opgaveindhold skal udfyldes.";
			return;
		}

		form.ExamType = isDigitalExam ? ExamType.Digital : ExamType.Analog;
		form.QuestionMethodRequirement = requiresSpecificMethod
			? QuestionMethodRequirement.SpecificMethod
			: requiresFormula
				? QuestionMethodRequirement.ApplyFormula
				: QuestionMethodRequirement.NoRequirement;

		form.StandardQuestion = markWithTwist
			? StandardQuestion.WithATwist
			: markAsPartiallyStandard
				? StandardQuestion.Partially
				: isStandardQuestion
					? StandardQuestion.Yes
					: StandardQuestion.No;

		form.DeletedAt = markAsDeleted ? DateTimeOffset.UtcNow : null;

		var createdQuestion = await QuestionService.CreateQuestionAsync(form);

		successMessage = $"Spoergsmaalet er oprettet og gemt (ID: {createdQuestion.Id}).";
		ResetForm();
	}

	private void Cancel()
	{
		ResetForm();
		successMessage = null;
		errorMessage = null;
		NavigationManager.NavigateTo("/teacher");
	}

	private void ResetForm()
	{
		form = new QuestionDTO
		{
			Education = Education.STX,
			ClassLevel = ClassLevel.B,
			QuestionDifficulty = QuestionDifficulty.Medium,
			ExamType = ExamType.Digital,
			QuestionMethodRequirement = QuestionMethodRequirement.NoRequirement,
			StandardQuestion = StandardQuestion.No,
			ImgSrc = string.Empty,
			Points = string.Empty,
			DeletedAt = null
		};

		isDigitalExam = true;
		isStandardQuestion = false;
		requiresFormula = false;
		requiresSpecificMethod = false;
		markAsPartiallyStandard = false;
		markWithTwist = false;
		markAsDeleted = false;
	}
}
