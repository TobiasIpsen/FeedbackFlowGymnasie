otelcol.receiver.otlp "otlp_receiver" {
  http {
    endpoint = "0.0.0.0:4317
  }
  output {
    traces = [otelcol.processor.batch.default.input]
    logs = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

// Batch provess for performance
otelcol.processor.batch "default" {
  output {
    traces = [otelcol.processor.attributes.default.input]
    logs = [otelcol.processor.attributes.default.input]
    metrics = [otelcol.processor.attributes.metrics.input]
  }
}

//Attributes processor for traces and logs
otelcol.processor.attributes "default" {
  output = {
    traces = [otelcol.exporter.otlp.tempoexpoter.input]
    logs = [otelcol.exporter.otlp.lokiexporter.input]
  }
}

//Processor for metrics
otelcol.processor.attributes "metrics" {
  action {
    key = "service_name"
    from_attribute = "service.name"
    action = "insert"
  }
  action {
    key = "service_instance_id"
    from_attribute = "service.instance.id"
    action = "insert"
  }
  output {
    metrcis = [otelcol.exporter.prometheus.prometheusexporter.input]
  }
}